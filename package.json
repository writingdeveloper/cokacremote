{
  "name": "cokacremote",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Unrestricted remote development MCP server with bounded process, file, image, and media tooling for Linux and Windows hosts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "profile:tools": "tsx scripts/profile-tools.ts",
    "doctor": "node dist/src/doctor.js",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writingdeveloper/cokacremote.git"
  },
  "homepage": "https://github.com/writingdeveloper/cokacremote#readme",
  "bugs": {
    "url": "https://github.com/writingdeveloper/cokacremote/issues"
  }
}
