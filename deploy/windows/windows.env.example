# Portable Windows runtime configuration. Copy to an untracked private file.
REPO_PATH=C:\path\to\cokacremote
MCP_ENV_FILE=C:\path\to\cokacremote\.env.production
NODE_EXE=node
SERVER_ENTRY=dist\src\server.js
SERVER_PORT=3000
HEALTH_URL=http://127.0.0.1:3000/health
SERVER_STDOUT_LOG=server.out.log
SERVER_STDERR_LOG=server.err.log
WATCHDOG_LOG=watchdog.log
WATCHDOG_FAILCOUNT_FILE=.watchdog-server-failcount
SUPERVISOR_RESTART_SECONDS=5

# Optional Cloudflare tunnel supervisor.
TUNNEL_ENABLED=false
TUNNEL_EXE=C:\path\to\cloudflared.exe
TUNNEL_CONFIG=C:\path\to\cloudflared-config.yml
TUNNEL_LOG=tunnel-cloudflared.log
